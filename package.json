{
  "name": "nuova-onda-box",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "pages:build": "next build --turbopack",
    "pages:dev": "npm run pages:build && wrangler pages dev out --d1 DB=nuova-onda-db",
    "deploy": "npm run pages:build && wrangler pages deploy out --project-name nuova-onda-box",
    "d1:create": "wrangler d1 create nuova-onda-db"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.5",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^3.78.0"
  }
}
